# JARVIS_NEXUS_CONFIG.env

####################################
#         FACEBOOK PERSONAL        #
####################################

[facebook]
# Numeric Facebook user ID, not username or page name
profile_id = ""  # e.g. 10001234567890
email = ""       # Your Facebook login email
password = ""    # Your Facebook login password

####################################
#         INSTAGRAM PERSONAL       #
####################################

[instagram]
# Numeric Instagram user ID, not username
account_id = ""  # e.g. 123456789
email = ""       # Your Instagram login email or username
password = ""    # Your Instagram login password

####################################
#           YOUTUBE PERSONAL       #
####################################

[youtube]
# YouTube Channel ID (not custom URL, not username)
channel_id = ""  # e.g. UCxxxxxxxxxxxxxxxx
email = ""       # Your Google/YouTube login email
password = ""    # Your Google/YouTube login password

####################################
#           SYSTEM FLAGS           #
####################################

[system]
# Mode can be 'playwright' or 'api' (default: playwright)
automation_mode = "playwright"
# Debug mode: 'true' for verbose logging, 'false' for production
debug = "false"